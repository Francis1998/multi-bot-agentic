{
  "mcpServers": {
    "fs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2.2.0", "${MCP_FS_ROOT:-.}"],
      "allowedTools": ["read_text_file", "list_directory"],
      "callTimeoutSeconds": 20,
      "startupTimeoutSeconds": 90,
      "maxResultBytes": 8192
    },
    "fs-legacy": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.12.18", "${MCP_FS_ROOT:-.}"],
      "allowedTools": ["read_text_file"],
      "startupTimeoutSeconds": 90
    }
  }
}
