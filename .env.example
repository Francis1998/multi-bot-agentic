# Provider selection: fake, openai, claude_code, gemini, kimi
MULTIBOT_PROVIDER=fake
# Fake provider: tool requested on the first turn (default checklist), e.g. mcp__notes__search_notes
MULTIBOT_FAKE_TOOL=
# Fake provider: model id its deterministic usage is priced as (default fake, $0), e.g. gpt-6.2-sol to
# rehearse --max-cost-usd offline. See docs/guides/USAGE_LIMITS_GUIDE.md.
MULTIBOT_FAKE_MODEL=

# OpenAI-compatible GPT adapter (GPT-6.2: gpt-6.2-sol, gpt-6.2-astra for the hardest work; also
# gpt-6.1-terra, gpt-6-luna). gpt-6.1-sol and gpt-6-astra are superseded by GPT-6.2 but still available
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# Reasoning + visible output budget (default 32768); lower it for models with smaller output limits
OPENAI_MAX_COMPLETION_TOKENS=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# Claude Code CLI adapter. Blank uses the default "claude -p" (print mode, Claude Code's
# non-interactive mode; the prompt is sent on stdin). Keep -p when you pick a model, e.g.
# "claude -p --model claude-opus-5-5" (current: claude-opus-5-5, claude-fable-5-2,
# claude-sonnet-5-5, claude-haiku-5-5). Add --output-format json to record each call's token usage and
# Claude Code's own cost estimate (plain-text output reports no usage).
CLAUDE_CODE_COMMAND=

# Gemini adapter. gemini-4-hydrogen is Google's recommended upgrade from 3.8 Flash; read
# docs/CONFIGURATION.md#gemini-default before switching. gemini-4-neon for frontier-level complex
# tasks, gemini-4-carbon for the strongest reasoning, gemini-4-argon for efficient frontier
# reasoning (all three paid tier only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Kimi / Moonshot adapter (K3 series: kimi-k3.1-pro, kimi-k3.1-pro-highspeed, kimi-k3). The K2
# series closed to new users on 2026-10-31 and retires by the end of December 2026
KIMI_API_KEY=
KIMI_MODEL=kimi-k3.1-pro
KIMI_MAX_COMPLETION_TOKENS=
KIMI_BASE_URL=https://api.moonshot.ai/v1/chat/completions

# Safety defaults
MULTIBOT_MAX_STEPS=6
MULTIBOT_TIMEOUT_SECONDS=30
MULTIBOT_MAX_PROMPT_CHARS=4000
MULTIBOT_EVENT_LOG=data/runs.sqlite
MULTIBOT_CANCEL_FILE=
# Tools whose calls pause the run until a human approves or rejects them (names or fnmatch patterns,
# comma-separated, e.g. checklist,mcp__*). --require-approval replaces it. See docs/guides/HITL_INTERRUPTS_GUIDE.md.
MULTIBOT_REQUIRE_APPROVAL=
# Optional JSON price file (USD per 1M tokens) that adds models to the built-in price table or replaces
# their prices: {"models": {"<model id>": {"input": 0.5, "output": 3.0, "cached_input": 0.05}}}.
MULTIBOT_PRICES_FILE=
